#!/bin/sh
# clice 启动器：把调用转交给 VS Code 插件自带的 clice。
#
# 为什么需要它：插件的安装目录带版本后缀（clice-io.clice-<版本>-<平台>），扩展升级后路径会变，
# 不能把某个具体路径写死在文档或脚本里；这个脚本每次挑“版本号最大的那个”。
#
# 解析顺序：
#   1. 环境变量 CLICE_BIN（显式指定，优先级最高）
#   2. ~/.vscode-server/extensions/clice-io.clice-*/clice/bin/clice（远程/WSL 场景，取最新）
#   3. ~/.vscode/extensions/clice-io.clice-*/clice/bin/clice（桌面版 VS Code）
#   4. PATH 上的 clice
#
# 用法：tools/clice <子命令> [选项]（参数原样转交，见 tools/clice --help）

set -eu

resolve_clice() {
    if [ -n "${CLICE_BIN:-}" ] && [ -x "${CLICE_BIN}" ]; then
        printf '%s\n' "${CLICE_BIN}"
        return 0
    fi

    for root in "${HOME}/.vscode-server/extensions" "${HOME}/.vscode/extensions"; do
        [ -d "${root}" ] || continue
        found=$(ls -d "${root}"/clice-io.clice-*/clice/bin/clice 2>/dev/null | sort -V | tail -n 1)
        if [ -n "${found}" ] && [ -x "${found}" ]; then
            printf '%s\n' "${found}"
            return 0
        fi
    done

    if command -v clice >/dev/null 2>&1; then
        command -v clice
        return 0
    fi

    return 1
}

binary=$(resolve_clice) || {
    echo "clice: 未找到可用的 clice 二进制" >&2
    echo "clice: 预期位置 ~/.vscode-server/extensions/clice-io.clice-*/clice/bin/clice" >&2
    echo "clice: 或设置 CLICE_BIN=/path/to/clice 显式指定" >&2
    exit 127
}

exec "${binary}" "$@"
